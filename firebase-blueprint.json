{
  "entities": {
    "remarks": {
      "title": "Student Remarks & Counseling Notes",
      "description": "Faculty counseling notes and behavioral remarks for students stored in Firebase Firestore",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentRegNo": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 128 },
        "facultyId": { "type": "string", "maxLength": 128 },
        "facultyName": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "remark": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["studentId", "facultyId", "remark"]
    }
  },
  "firestore": {
    "/remarks/{remarkId}": {
      "schema": "remarks",
      "description": "Faculty student counseling remarks collection"
    }
  }
}
